# PostgreSQL connection string (use a Neon, Supabase, or local Postgres URL)
DATABASE_URL="postgresql://user:password@localhost:5432/hrms?schema=public"

# NextAuth.js — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# The canonical URL of your site (used by NextAuth for redirects and callbacks)
NEXTAUTH_URL="http://localhost:3000"
